# ─────────────────────────────────────────────────────────────────────────────
# Kabir Talks — environment variables
# Copy to .env.local (never commit .env.local) and fill in the values.
# REQUIRED values crash the app at startup if missing (see src/lib/env.ts).
# OPTIONAL values only switch their feature off (see src/lib/features.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# REQUIRED. Runtime connection: Supabase "Transaction pooler", port 6543.
# Supabase dashboard → Connect → "Transaction pooler".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Optional: connection pool size (default 1 in production, 5 in development).
# One shared pool per server process. Leave empty for Supabase, or keep it at
# 1-3: every Vercel instance has its own pool. Set to 1 when testing against a single-backend
# local stand-in such as PGlite, which can't run queries in parallel.
DATABASE_POOL_MAX=""

# REQUIRED for migrations only (npm run db:migrate / db:studio). Not used by the app.
# Supabase dashboard → Connect → "Direct connection", port 5432.
# (If your network has no IPv6, use the "Session pooler" string on port 5432 instead.)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters. Generate with: npx auth secret
BETTER_AUTH_SECRET=""
# REQUIRED. The public URL of the site (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# REQUIRED. Same as above in most setups; used for metadata and trusted origins.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin account (read only by `npm run seed:admin`) ────────────────────────
ADMIN_EMAIL="you@example.com"
# At least 8 characters. Use a strong, unique password.
ADMIN_PASSWORD=""

# ── Google sign-in (OPTIONAL — hidden unless BOTH are set) ───────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Supabase Storage (used from Phase 2 for images) ──────────────────────────
# Supabase dashboard → Project Settings → API. Without both, image uploads show
# "Storage not configured". Then create the bucket: npm run storage:setup (README step 6).
NEXT_PUBLIC_SUPABASE_URL=""
# SERVER ONLY. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ── AI (OPTIONAL — enables Phase 3 and 6 AI features) ────────────────────────
# With none of these set, every AI button shows "Coming soon" and nothing breaks.
# SERVER ONLY. Google AI Studio (https://aistudio.google.com) → Get API key.
GEMINI_API_KEY=""
# Optional. Defaults to gemini-3.8-flash. Model codes: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=""
# Optional. "Listen" text-to-speech (Phase 6). Defaults: gemini-3.8-flash-tts and voice "Kore".
# Voices: https://ai.google.dev/gemini-api/docs/speech-generation. Gemini TTS does not support
# Urdu (checked 2026-10-26), so Urdu articles use the reader's browser voice when there is one.
# Audio is stored in the "article-audio" Storage bucket: run `npm run storage:setup` again.
GEMINI_TTS_MODEL=""
GEMINI_TTS_VOICE=""
# Optional: gemini (default) | mock. "mock" gives fake, deterministic AI output for
# local development without a key or costs. It is ignored in production builds.
AI_PROVIDER=""
# Optional cost guards. All are stored in the database, so they hold across every
# Vercel instance. Days are Pakistan dates: daily limits reset at midnight PKT.
# AI model calls allowed per admin per minute (default 30).
AI_RATE_LIMIT_PER_MINUTE=""
# Global cap on AI model calls per day, ALL features together: editor AI, summaries,
# "Ask this article" and audio (one call per audio chunk). Default 1000. When it is
# reached, readers see "AI features are resting for today" and the admin sees why.
AI_DAILY_LIMIT=""
# "Ask this article" questions each signed-in reader may ask per day (default 20).
READER_AI_ASK_PER_DAY=""

# ── Email (OPTIONAL — Phase 7: account emails and the newsletter) ───────────
# Real sending needs BOTH values below. Without them every email goes to the
# "log" driver: the server console plus Admin → Email outbox, where you can
# preview it. Account emails (sign-up verification, "Forgot password?") and the
# newsletter stay OFF until a real sender is configured, so readers never wait
# for an email that was only logged.
# Resend dashboard (https://resend.com) → API Keys. SERVER ONLY.
RESEND_API_KEY=""
# Sender, on a domain you verified in Resend → Domains. Either form works:
#   "Kabir Talks <news@kabirtalks.com>"   or   news@kabirtalks.com
EMAIL_FROM=""
# LOCAL TESTING ONLY. 1 = treat the log driver as a real sender, so verification,
# password reset and the newsletter work end to end and you read their links in
# Admin → Email outbox. Never set this on the live server.
EMAIL_TEST_MODE=""

# ── Newsletter queue (OPTIONAL — Phase 7) ────────────────────────────────────
# Newsletters are queued, then sent in small batches by either:
#   npm run newsletter:process     (plain script, e.g. a cron job every 5 minutes)
#   POST /api/cron/newsletter       with header "Authorization: Bearer <this secret>"
#   POST /api/cron/newsletter?task=digest   queues this week's digest (once per week)
# The endpoint is OFF (404) while this is empty. At least 32 characters:
#   openssl rand -hex 32
NEWSLETTER_CRON_SECRET=""
